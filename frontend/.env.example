# URL do backend Python (FastAPI)
BACKEND_URL=http://localhost:8000

# ── Login (server-side; nunca vão para o browser) ──────────
# O login é por e-mail e senha e é validado pelo backend. Usuários são criados
# com `python -m scripts.create_user` (ver README).
# Chave para assinar o cookie de sessão. Trocar = desloga todo mundo.
# Gere com:  openssl rand -base64 32
SESSION_SECRET=
# Mesmo valor de API_SECRET no backend.
BACKEND_API_SECRET=
