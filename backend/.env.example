# ── App ─────────────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# ── Banco (Supabase Postgres) ───────────────────────────────
# Pegue em: Supabase > Project Settings > Database > Connection string.
# Use a string do *Connection pooling* (Transaction mode) e troque o
# prefixo para "postgresql+psycopg". Exemplo:
# postgresql+psycopg://postgres.PROJECTREF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/inboxpilot
DB_ECHO=false

# ── Meta / Instagram Graph API ──────────────────────────────
# App em https://developers.facebook.com/apps
META_APP_ID=
META_APP_SECRET=

# Token que VOCÊ inventa e repete no painel da Meta ao configurar o webhook.
WEBHOOK_VERIFY_TOKEN=troque-este-valor

# Para onde a Meta redireciona após a autorização.
OAUTH_REDIRECT_URI=http://localhost:8000/instagram/callback

GRAPH_API_VERSION=v21.0
